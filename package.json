{
  "name": "office-atlas-ui-tests",
  "private": true,
  "scripts": {
    "test:palette": "node --experimental-vm-modules tests/shared_palette_dom.cjs",
    "test": "python tests/run_all.py",
    "format:check": "prettier --check \"frontend/react/**/*.{js,jsx,css}\" \"frontend/assets/*.js\" \"frontend/*.html\" \"atlas/*.{js,css,html}\"",
    "build:ui": "vite build",
    "watch:ui": "vite build --watch",
    "format": "prettier --write \"frontend/react/**/*.{js,jsx,css}\" \"frontend/assets/*.js\" \"frontend/*.html\" \"atlas/*.{js,css,html}\"",
    "vendor:sync": "python tools/vendor_frontend.py"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "acorn": "^8.18.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.7"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dompurify": "3.4.17",
    "lucide-react": "^1.54.0",
    "marked": "18.0.14",
    "mermaid": "12.3.0",
    "motion": "^14.0.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
